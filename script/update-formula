#!/usr/bin/env bash
# Regenerate Formula/goose.rb from the latest release of thisguycodes/goose.
# Usage: script/update-formula [tag]   (defaults to the latest release)
set -euo pipefail

REPO="thisguycodes/goose"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FORMULA="$ROOT/Formula/goose.rb"

TAG="${1:-}"
if [[ -z "$TAG" ]]; then
  TAG="$(curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["tag_name"])')"
fi
VERSION="${TAG#v}"
echo "Latest release: $TAG"

# triple -> ruby token
declare -A TARGETS=(
  [aarch64-apple-darwin]=SHA_DARWIN_ARM64
  [x86_64-apple-darwin]=SHA_DARWIN_X64
  [aarch64-unknown-linux-gnu]=SHA_LINUX_ARM64
  [x86_64-unknown-linux-gnu]=SHA_LINUX_X64
)

if command -v sha256sum >/dev/null; then
  sha256() { sha256sum | awk '{print $1}'; }
else
  sha256() { shasum -a 256 | awk '{print $1}'; }
fi

declare -A SHAS=()
for triple in "${!TARGETS[@]}"; do
  url="https://github.com/$REPO/releases/download/$TAG/goose-$triple.tar.bz2"
  echo "Fetching $url"
  SHAS[$triple]="$(curl -fsSL "$url" | sha256)"
done

mkdir -p "$ROOT/Formula"
cat > "$FORMULA" <<RUBY
# Generated by script/update-formula from $REPO $TAG — do not edit by hand.
class Goose < Formula
  desc "Open-source, extensible AI agent that goes beyond code suggestions (thisguycodes fork)"
  homepage "https://github.com/$REPO"
  version "$VERSION"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/$REPO/releases/download/v#{version}/goose-aarch64-apple-darwin.tar.bz2"
      sha256 "${SHAS[aarch64-apple-darwin]}"
    end
    on_intel do
      url "https://github.com/$REPO/releases/download/v#{version}/goose-x86_64-apple-darwin.tar.bz2"
      sha256 "${SHAS[x86_64-apple-darwin]}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/$REPO/releases/download/v#{version}/goose-aarch64-unknown-linux-gnu.tar.bz2"
      sha256 "${SHAS[aarch64-unknown-linux-gnu]}"
    end
    on_intel do
      url "https://github.com/$REPO/releases/download/v#{version}/goose-x86_64-unknown-linux-gnu.tar.bz2"
      sha256 "${SHAS[x86_64-unknown-linux-gnu]}"
    end
  end

  def install
    bin.install "goose"
  end

  test do
    system bin/"goose", "--version"
  end
end
RUBY

echo "Wrote $FORMULA (version $VERSION)"
